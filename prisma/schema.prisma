generator client {
  provider        = "prisma-client-js"
  // Required by the Neon driver adapter wired up in lib/db.ts.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ScrapedItem {
  id          String    @id @default(cuid())
  title       String
  description String?
  sourceUrl   String    @unique
  source      String
  category    String
  imageUrl    String?
  pubDate     DateTime?
  scrapedAt   DateTime  @default(now())
  status      String    @default("pending")
  // Failed items are requeued until this hits MAX_RETRIES (see cron/process).
  retries     Int       @default(0)
  // When the item was last claimed, so a run that dies mid-batch can be
  // detected and its items reclaimed instead of stranding on "processing".
  claimedAt   DateTime?

  @@index([status])
  @@index([status, retries])
}

model Article {
  id          String    @id @default(cuid())
  title       String
  content     String
  excerpt     String
  slug        String    @unique
  imageUrl    String?
  imageAlt    String?
  imageCredit String?
  category    String
  source      String
  sourceUrl   String    @unique
  publishedAt DateTime
  published   Boolean   @default(false)
  scheduledAt DateTime?
  views       Int       @default(0)
  tags        String[]  @default([])
  entities    String[]  @default([])
  pullQuote   String?
  editorNote  String?
  reviewData  Json?
  seriesId    String?
  seriesOrder Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Set once the social cron has announced the article. Replaces the old
  // "published in the last N minutes" window, which both missed articles when a
  // run was skipped and double-posted the ones landing on a window boundary.
  socialPostedAt DateTime?
  series      Series?   @relation(fields: [seriesId], references: [id])

  @@index([category])
  @@index([publishedAt(sort: Desc)])
  @@index([views(sort: Desc)])
  @@index([seriesId])
  // Tag and topic archives filter with array containment (`has` / `hasSome`),
  // which without a GIN index is a sequential scan of every article on each
  // ISR revalidation — the bulk of what those routes cost on Neon.
  @@index([tags(ops: ArrayOps)], type: Gin)
  @@index([entities(ops: ArrayOps)], type: Gin)
}

model Series {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  imageUrl    String?
  category    String
  topics      Json      @default("[]")
  synopsis    String?
  status      String?
  genres      String[]  @default([])
  externalUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())
}
