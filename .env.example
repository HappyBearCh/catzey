# Database (PostgreSQL - use Neon free tier: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Gemini API key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Secret to protect cron endpoint (any random string, e.g. `openssl rand -hex 32`)
CRON_SECRET=your-cron-secret

# Admin panel password
ADMIN_PASSWORD=your-admin-password

# Next.js public URL (used for internal API calls from cron)
NEXT_PUBLIC_SITE_URL=https://catzye.com
